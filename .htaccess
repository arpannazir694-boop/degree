RewriteEngine On

# 1. কেউ যদি সরাসরি .html সহ লিখে আসে, তবে তাকে ক্লিন URL-এ রিডাইরেক্ট (301) করবে
# যেমন: dedegree.in/collections.html -> dedegree.in/collections
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.*?)(?:\.html)?[\s?] [NC]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.*?)\.html[\s?] [NC]
RewriteRule ^ %1 [R=301,L]

# 2. ক্লিন URL আসলে সার্ভার ভেতর থেকে সংশ্লিষ্ট .html ফাইলটি লোড করবে
# যেমন: dedegree.in/collections আসলে ভেতর থেকে collections.html ফাইলটি দেখাবে
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]

# 3. ব্রাউজার ক্যাশিং কন্ট্রোল (Cache-Control Headers)
<IfModule mod_headers.c>
  # HTML ফাইল যাতে ব্রাউজার কখনো মেমোরিতে ক্যাশ না করে (সবসময় সার্ভার থেকে লেটেস্ট HTML আসবে)
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # CSS ও JS ফাইলের জন্য ব্রাউজার ক্যাশ (যেহেতু লিঙ্কগুলোতে ?v= দেওয়া আছে, ভার্সন পাল্টালে অটো ডাউনলোড হবে)
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
